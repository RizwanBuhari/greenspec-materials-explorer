# Copy to secrets.toml locally, or paste into Streamlit Cloud under App settings > Secrets.
# Never commit the real secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: the Claude model and the most AI requests the app will make per day.
# ANTHROPIC_MODEL = "claude-opus-5-5"
# AI_DAILY_LIMIT = "100"

# Optional: a Google Sheet published as CSV (File > Share > Publish to web > CSV).
# Without it, the app reads data/materials.csv.
# GOOGLE_SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/.../pub?output=csv"
